-- Chuyển tab
local function SwitchTab(tab)
    FarmFrame.Visible = (tab == "farm")
    SellFrame.Visible = (tab == "sell")
    TeleFrame.Visible = (tab == "tele")
    MusicFrame.Visible = (tab == "music")

    BtnTabFarm.BackgroundColor3 = Color3.fromRGB(70, 75, 100); BtnTabFarm.TextColor3 = C.dim
    BtnTabSell.BackgroundColor3 = Color3.fromRGB(70, 75, 100); BtnTabSell.TextColor3 = C.dim
    BtnTabTele.BackgroundColor3 = Color3.fromRGB(70, 75, 100); BtnTabTele.TextColor3 = C.dim
    BtnTabMusic.BackgroundColor3 = Color3.fromRGB(70, 75, 100); BtnTabMusic.TextColor3 = C.dim

    if tab == "farm" then BtnTabFarm.BackgroundColor3 = Color3.fromRGB(35, 55, 45); BtnTabFarm.TextColor3 = C.grn
    elseif tab == "sell" then BtnTabSell.BackgroundColor3 = Color3.fromRGB(50, 45, 30); BtnTabSell.TextColor3 = C.gold
    elseif tab == "tele" then BtnTabTele.BackgroundColor3 = Color3.fromRGB(30, 40, 55); BtnTabTele.TextColor3 = C.cyan
    elseif tab == "music" then BtnTabMusic.BackgroundColor3 = Color3.fromRGB(55, 35, 55); BtnTabMusic.TextColor3 = C.purple end
end

