local function CheckFish()
    local pg = P:FindFirstChild("PlayerGui")
    if pg then
        for _, g in pairs(pg:GetDescendants()) do
            if (g:IsA("TextLabel") or g:IsA("TextButton")) then
                if string.find(string.lower(tostring(g.Text or "")), "fish caught") then return true end
            end
        end
    end
    return false
end

task.spawn(function()
    while true do
        task.wait(0.1)
        if _G.AutoFish then
            Status.Text = "● Thả cần..."
            Click(0.5 + math.random() * 0.3)
            rndDelay(3.5, 1)
            Status.Text = "● Chờ cá..."
            local startT = tick()
            local caught = false
            while _G.AutoFish and (tick() - startT < 20) do
                if CheckFish() then caught = true break end
                task.wait(0.3 + math.random() * 0.3)
            end
            if caught then
                local currentFish = getFish()
                updateFishHUD()
                Status.Text = "● Đã câu! Kho: " .. currentFish
                Status.TextColor3 = C.grn
                task.spawn(function() showToast("🐟 +1 cá", C.cyan) end)
                rndDelay(1, 0.3)
            end
        else
            task.wait(0.2)
        end
    end
end)

